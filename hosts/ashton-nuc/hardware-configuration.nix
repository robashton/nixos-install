{ config, lib, pkgs, ... }:

{
  imports = [];

  boot.initrd.availableKernelModules = [ "xhci_pci" "nvme" "usbhid" "usb_storage" "sd_mod" "sdhci_pci" ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

  fileSystems."/" =
    { device = "/dev/disk/by-uuid/bd6e5862-c94c-4795-894b-e6d979b4c202";
      fsType = "ext4";
    };

  # /home is no longer its own filesystem: the old home partition was deleted and
  # root grown over it, so the whole disk is one 444G pool shared by nix and docker.

  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/7C81-4FB8";
      fsType = "vfat";
    };

  swapDevices =
    [ { device = "/dev/disk/by-uuid/4d163f0a-773d-47af-8df4-3b563620dad0"; }
    ];

  nix.settings.max-jobs = lib.mkDefault 8;
  powerManagement.cpuFreqGovernor = lib.mkDefault "powersave";
  # High-DPI console
  console.font = lib.mkDefault "${pkgs.terminus_font}/share/consolefonts/ter-u28n.psf.gz";
}
